{
  "$description": "Driftcoin Business design tokens (W3C DTCG format). Primitives live under `palette`; components only reference the semantic groups.",
  "palette": {
    "ink": {
      "900": { "$value": "#0B1B2B", "$type": "color" },
      "800": { "$value": "#13304A", "$type": "color" },
      "700": { "$value": "#22415E", "$type": "color" }
    },
    "slate": {
      "600": { "$value": "#4A5868", "$type": "color" },
      "500": { "$value": "#6A7886", "$type": "color" },
      "400": { "$value": "#8FA0B0", "$type": "color" },
      "300": { "$value": "#C9D2DB", "$type": "color" },
      "200": { "$value": "#E3E7EB", "$type": "color" },
      "100": { "$value": "#F3F5F7", "$type": "color" }
    },
    "green": {
      "800": { "$value": "#0A5C4C", "$type": "color" },
      "700": { "$value": "#0E7C66", "$type": "color" },
      "300": { "$value": "#5EE0B8", "$type": "color" },
      "100": { "$value": "#DDF3EC", "$type": "color" }
    },
    "amber": {
      "400": { "$value": "#F5B83D", "$type": "color" },
      "100": { "$value": "#FCEBC4", "$type": "color" }
    },
    "blue": {
      "100": { "$value": "#E1E8F5", "$type": "color" }
    },
    "white": { "$value": "#FFFFFF", "$type": "color" }
  },
  "color": {
    "background": { "$value": "{palette.white}", "$type": "color", "$description": "Default page background" },
    "surface": { "$value": "{palette.slate.100}", "$type": "color", "$description": "Soft grey section background" },
    "surfaceInverse": { "$value": "{palette.ink.900}", "$type": "color", "$description": "Dark section background (hero, footer)" },
    "surfaceInverseRaised": { "$value": "{palette.ink.800}", "$type": "color", "$description": "Raised panel on a dark background" },
    "text": { "$value": "{palette.ink.900}", "$type": "color", "$description": "Default text" },
    "textMuted": { "$value": "{palette.slate.600}", "$type": "color", "$description": "Secondary text on light backgrounds" },
    "textInverse": { "$value": "{palette.white}", "$type": "color", "$description": "Text on dark backgrounds" },
    "textInverseMuted": { "$value": "{palette.slate.300}", "$type": "color", "$description": "Secondary text on dark backgrounds" },
    "primary": { "$value": "{palette.green.700}", "$type": "color", "$description": "Brand primary, buttons and links" },
    "primaryHover": { "$value": "{palette.green.800}", "$type": "color", "$description": "Hover state for primary" },
    "primaryText": { "$value": "{palette.white}", "$type": "color", "$description": "Text on primary" },
    "accent": { "$value": "{palette.green.300}", "$type": "color", "$description": "Bright accent used on dark backgrounds" },
    "accentText": { "$value": "{palette.ink.900}", "$type": "color", "$description": "Text on accent" },
    "highlight": { "$value": "{palette.amber.400}", "$type": "color", "$description": "Announcement banner background" },
    "border": { "$value": "{palette.slate.200}", "$type": "color", "$description": "Default border" },
    "borderStrong": { "$value": "{palette.slate.300}", "$type": "color", "$description": "Dividers in accordions" },
    "tintGreen": { "$value": "{palette.green.100}", "$type": "color", "$description": "Green media background" },
    "tintAmber": { "$value": "{palette.amber.100}", "$type": "color", "$description": "Amber media background" },
    "tintBlue": { "$value": "{palette.blue.100}", "$type": "color", "$description": "Blue media background" }
  },
  "space": {
    "none": { "$value": "0px", "$type": "dimension" },
    "xs": { "$value": "8px", "$type": "dimension" },
    "sm": { "$value": "12px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "40px", "$type": "dimension" },
    "2xl": { "$value": "64px", "$type": "dimension" },
    "3xl": { "$value": "112px", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "sm": { "$value": "10px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "20px", "$type": "dimension" },
    "xl": { "$value": "28px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "fontFamily": {
    "display": { "$value": ["Space Grotesk", "sans-serif"], "$type": "fontFamily" },
    "body": { "$value": ["IBM Plex Sans", "sans-serif"], "$type": "fontFamily" },
    "mono": { "$value": ["IBM Plex Mono", "monospace"], "$type": "fontFamily" }
  },
  "fontSize": {
    "sm": { "$value": "14px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "18px", "$type": "dimension" },
    "xl": { "$value": "22px", "$type": "dimension" },
    "2xl": { "$value": "28px", "$type": "dimension" },
    "3xl": { "$value": "44px", "$type": "dimension" },
    "4xl": { "$value": "64px", "$type": "dimension" }
  },
  "fontWeight": {
    "regular": { "$value": 400, "$type": "fontWeight" },
    "medium": { "$value": 500, "$type": "fontWeight" },
    "semibold": { "$value": 600, "$type": "fontWeight" },
    "bold": { "$value": 700, "$type": "fontWeight" }
  }
}
